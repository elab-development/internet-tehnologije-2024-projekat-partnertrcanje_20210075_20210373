{
  "name": "trcanjepartner",
  "version": "1.0.0",
  "description": "Running Partner - A modern running community application with Laravel backend and React frontend",
  "main": "postcss.config.js",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "test": "echo \"Error: no test specified\" && exit 1",
    "backend:install": "cd backend && composer install",
    "backend:serve": "cd backend && php artisan serve",
    "backend:migrate": "cd backend && php artisan migrate",
    "backend:seed": "cd backend && php artisan db:seed",
    "frontend:install": "cd frontend/react-frontend && npm install",
    "frontend:dev": "cd frontend/react-frontend && npm run dev",
    "frontend:build": "cd frontend/react-frontend && npm run build",
    "install:all": "npm run backend:install && npm run frontend:install",
    "dev:all": "concurrently \"npm run backend:serve\" \"npm run frontend:dev\"",
    "setup": "npm run install:all && npm run backend:migrate"
  },
  "keywords": ["running", "community", "laravel", "react", "fitness"],
  "author": "Running Partner Team",
  "license": "ISC",
  "devDependencies": {
    "vite": "^6.0.3",
    "concurrently": "^8.2.2"
  }
}
